<style>
  .pause-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: #ffcc00;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .pause-title {
    font-size: 4;
    color: #ffcc00;
    font-weight: bold;
  }
  .pause-btn {
    background-color: rgba(255, 204, 0, 0.15);
    border-color: #ffcc00;
    border-width: 0.08;
    border-radius: 0.5;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 3;
    padding-right: 3;
    margin-top: 1;
    cursor: pointer;
  }
  .pause-btn-text {
    font-size: 2;
    color: #ffcc00;
    font-weight: bold;
  }
</style>
<div class="pause-panel">
  <span class="pause-title">PAUSED</span>
  <div id="btn-resume" class="pause-btn"><span class="pause-btn-text">RESUME</span></div>
  <div id="btn-quit" class="pause-btn"><span class="pause-btn-text">QUIT</span></div>
</div>
