<style>
  .go-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: #00ffff;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .go-title {
    font-size: 4;
    color: #00ffff;
    font-weight: bold;
  }
  .go-score {
    font-size: 2.5;
    color: #ffffff;
    margin-top: 0.5;
  }
  .go-stat {
    font-size: 1.4;
    color: #aaaaaa;
    margin-top: 0.3;
  }
  .go-mode {
    font-size: 1.2;
    color: #ff00ff;
    margin-top: 0.5;
  }
  .go-btn {
    background-color: rgba(0, 255, 255, 0.15);
    border-color: #00ffff;
    border-width: 0.08;
    border-radius: 0.5;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 3;
    padding-right: 3;
    margin-top: 1;
    cursor: pointer;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .go-btn-text {
    font-size: 1.8;
    color: #00ffff;
    font-weight: bold;
  }
</style>
<div class="go-panel">
  <span id="result-title" class="go-title">VICTORY!</span>
  <span id="result-score" class="go-score">11 - 5</span>
  <span id="result-rally" class="go-stat">Best Rally: 0</span>
  <span id="result-streak" class="go-stat">Best Streak: 0</span>
  <span id="result-aces" class="go-stat">Aces: 0</span>
  <span id="result-mode" class="go-mode">MATCH</span>
  <div id="btn-rematch" class="go-btn"><span class="go-btn-text">REMATCH</span></div>
  <div id="btn-title" class="go-btn"><span class="go-btn-text">TITLE</span></div>
</div>
