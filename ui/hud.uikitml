<style>
  .hud-panel {
    display: flex;
    flex-direction: column;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 0, 0, 0.7);
    border-color: #00ffff;
    border-width: 0.08;
    border-radius: 0.8;
  }
  .hud-score {
    font-size: 3;
    color: #00ffff;
    font-weight: bold;
  }
  .hud-info {
    font-size: 1.3;
    color: #aaaaaa;
  }
  .hud-serve {
    font-size: 1.2;
    color: #ff00ff;
  }
  .hud-combo {
    font-size: 1.4;
    color: #ffcc00;
  }
</style>
<div class="hud-panel">
  <span id="hud-score" class="hud-score">0 - 0</span>
  <span id="hud-sets" class="hud-info">Sets: 0 - 0</span>
  <span id="hud-serve" class="hud-serve">YOUR SERVE</span>
  <span id="hud-combo" class="hud-combo"></span>
</div>
