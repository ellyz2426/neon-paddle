<style>
  .diff-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 0, 0, 0.85);
    border-color: #00ffff;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .diff-title {
    font-size: 3;
    color: #00ffff;
    font-weight: bold;
  }
  .diff-btn {
    background-color: rgba(0, 255, 255, 0.12);
    border-color: #00ffff;
    border-width: 0.06;
    border-radius: 0.4;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 3;
    padding-right: 3;
    margin-top: 0.8;
    cursor: pointer;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .diff-text {
    font-size: 2;
    color: #00ffff;
    font-weight: bold;
  }
  .back-btn {
    background-color: rgba(255, 0, 255, 0.1);
    border-color: #ff00ff;
    border-width: 0.06;
    border-radius: 0.4;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    margin-top: 1;
    cursor: pointer;
  }
  .back-text {
    font-size: 1.5;
    color: #ff00ff;
  }
</style>
<div class="diff-panel">
  <span class="diff-title">DIFFICULTY</span>
  <div id="btn-diff-0" class="diff-btn"><span class="diff-text">EASY</span></div>
  <div id="btn-diff-1" class="diff-btn"><span class="diff-text">MEDIUM</span></div>
  <div id="btn-diff-2" class="diff-btn"><span class="diff-text">HARD</span></div>
  <div id="btn-back-diff" class="back-btn"><span class="back-text">BACK</span></div>
</div>
