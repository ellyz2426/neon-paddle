<style>
  .tb-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: #ffaa00;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .tb-title {
    font-size: 3.5;
    color: #ffaa00;
    font-weight: bold;
  }
  .tb-subtitle {
    font-size: 1.5;
    color: #ff8800;
    margin-top: 0.3;
  }
  .tb-round {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.5;
    padding-right: 1.5;
    margin-top: 0.5;
    background-color: rgba(255, 170, 0, 0.08);
    border-color: #ffaa00;
    border-width: 0.04;
    border-radius: 0.4;
    width: 100%;
  }
  .tb-round-num {
    font-size: 1.3;
    color: #888888;
    width: 10%;
  }
  .tb-opponent {
    font-size: 1.6;
    color: #ffaa00;
    font-weight: bold;
    width: 35%;
  }
  .tb-result {
    font-size: 1.4;
    color: #aaaaaa;
    width: 30%;
  }
  .tb-status {
    font-size: 1.4;
    color: #00ffff;
    width: 25%;
  }
  .tb-btn {
    background-color: rgba(255, 170, 0, 0.15);
    border-color: #ffaa00;
    border-width: 0.08;
    border-radius: 0.5;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 3;
    padding-right: 3;
    margin-top: 1;
    cursor: pointer;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .tb-btn-text {
    font-size: 1.8;
    color: #ffaa00;
    font-weight: bold;
  }
  .back-btn {
    background-color: rgba(255, 0, 255, 0.1);
    border-color: #ff00ff;
    border-width: 0.06;
    border-radius: 0.4;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    margin-top: 0.8;
    cursor: pointer;
  }
  .back-text {
    font-size: 1.5;
    color: #ff00ff;
  }
</style>
<div class="tb-panel">
  <span class="tb-title">TOURNAMENT</span>
  <span class="tb-subtitle">Defeat all 4 opponents</span>
  <div class="tb-round">
    <span id="tb-rnd-0" class="tb-round-num">QF</span>
    <span id="tb-opp-0" class="tb-opponent">SPARK</span>
    <span id="tb-score-0" class="tb-result">---</span>
    <span id="tb-stat-0" class="tb-status">NEXT</span>
  </div>
  <div class="tb-round">
    <span id="tb-rnd-1" class="tb-round-num">SF</span>
    <span id="tb-opp-1" class="tb-opponent">PULSE</span>
    <span id="tb-score-1" class="tb-result">---</span>
    <span id="tb-stat-1" class="tb-status"></span>
  </div>
  <div class="tb-round">
    <span id="tb-rnd-2" class="tb-round-num">F1</span>
    <span id="tb-opp-2" class="tb-opponent">VORTEX</span>
    <span id="tb-score-2" class="tb-result">---</span>
    <span id="tb-stat-2" class="tb-status"></span>
  </div>
  <div class="tb-round">
    <span id="tb-rnd-3" class="tb-round-num">FN</span>
    <span id="tb-opp-3" class="tb-opponent">CIPHER</span>
    <span id="tb-score-3" class="tb-result">---</span>
    <span id="tb-stat-3" class="tb-status"></span>
  </div>
  <div id="btn-tournament-play" class="tb-btn"><span class="tb-btn-text">FIGHT!</span></div>
  <div id="btn-back-tournament_bracket" class="back-btn"><span class="back-text">BACK</span></div>
</div>
