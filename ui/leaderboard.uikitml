<style>
  .lb-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: #00ffff;
    border-width: 0.12;
    border-radius: 1.2;
  }
  .lb-title {
    font-size: 3;
    color: #00ffff;
    font-weight: bold;
  }
  .lb-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 0.3;
    padding-top: 0.2;
    padding-bottom: 0.2;
    padding-left: 0.5;
    padding-right: 0.5;
    border-color: rgba(0, 255, 255, 0.1);
    border-width: 0;
    border-bottom-width: 0.03;
  }
  .lb-rank {
    font-size: 1.2;
    color: #ffcc00;
    width: 10%;
  }
  .lb-score {
    font-size: 1.2;
    color: #ffffff;
    width: 40%;
  }
  .lb-mode {
    font-size: 1.2;
    color: #aaaaaa;
    width: 25%;
  }
  .lb-date {
    font-size: 1.1;
    color: #666666;
    width: 25%;
  }
  .back-btn {
    background-color: rgba(255, 0, 255, 0.1);
    border-color: #ff00ff;
    border-width: 0.06;
    border-radius: 0.4;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    margin-top: 1;
    cursor: pointer;
  }
  .back-text {
    font-size: 1.5;
    color: #ff00ff;
  }
</style>
<div class="lb-panel">
  <span class="lb-title">LEADERBOARD</span>
  <div class="lb-row"><span class="lb-rank">#</span><span class="lb-score">SCORE</span><span class="lb-mode">MODE</span><span class="lb-date">DATE</span></div>
  <div class="lb-row"><span id="lb-rank-0" class="lb-rank">1</span><span id="lb-score-0" class="lb-score">-</span><span id="lb-mode-0" class="lb-mode">-</span><span id="lb-date-0" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-1" class="lb-rank">2</span><span id="lb-score-1" class="lb-score">-</span><span id="lb-mode-1" class="lb-mode">-</span><span id="lb-date-1" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-2" class="lb-rank">3</span><span id="lb-score-2" class="lb-score">-</span><span id="lb-mode-2" class="lb-mode">-</span><span id="lb-date-2" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-3" class="lb-rank">4</span><span id="lb-score-3" class="lb-score">-</span><span id="lb-mode-3" class="lb-mode">-</span><span id="lb-date-3" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-4" class="lb-rank">5</span><span id="lb-score-4" class="lb-score">-</span><span id="lb-mode-4" class="lb-mode">-</span><span id="lb-date-4" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-5" class="lb-rank">6</span><span id="lb-score-5" class="lb-score">-</span><span id="lb-mode-5" class="lb-mode">-</span><span id="lb-date-5" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-6" class="lb-rank">7</span><span id="lb-score-6" class="lb-score">-</span><span id="lb-mode-6" class="lb-mode">-</span><span id="lb-date-6" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-7" class="lb-rank">8</span><span id="lb-score-7" class="lb-score">-</span><span id="lb-mode-7" class="lb-mode">-</span><span id="lb-date-7" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-8" class="lb-rank">9</span><span id="lb-score-8" class="lb-score">-</span><span id="lb-mode-8" class="lb-mode">-</span><span id="lb-date-8" class="lb-date">-</span></div>
  <div class="lb-row"><span id="lb-rank-9" class="lb-rank">10</span><span id="lb-score-9" class="lb-score">-</span><span id="lb-mode-9" class="lb-mode">-</span><span id="lb-date-9" class="lb-date">-</span></div>
  <div id="btn-back-leaderboard" class="back-btn"><span class="back-text">BACK</span></div>
</div>
